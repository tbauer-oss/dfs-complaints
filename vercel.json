{
  "version": 2,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://dfs-complaints-web.vercel.app" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type, X-Requested-With" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,PATCH,DELETE,OPTIONS" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "has": [{ "type": "method", "value": "OPTIONS" }],
      "destination": "/api/_options.js"
    }
  ],
  "crons": [
    { "path": "/api/cron/training-recurrence", "schedule": "0 * * * *" }
  ]
}
