{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "headers": {
        "Access-Control-Allow-Origin": "https://dfs-complaints-web.vercel.app",
        "Access-Control-Allow-Credentials": "true",
        "Access-Control-Allow-Headers": "Authorization, Content-Type, X-Requested-With, X-Admin-Secret, X-Gate, X-Rep-Secret",
        "Access-Control-Allow-Methods": "GET,POST,PUT,PATCH,DELETE,OPTIONS"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "methods": [
        "OPTIONS"
      ],
      "dest": "/api/options"
    },
    {
      "src": "/api/internal-audits/(.*)",
      "methods": [
        "OPTIONS"
      ],
      "dest": "/api/internal-audits/options"
    },
    {
      "src": "/api/internal-audits/([^/]+)/plan$",
      "dest": "/api/internal-audits/[id]/plan.js?id=$1"
    },
    {
      "src": "/api/internal-audits/([^/]+)/evidence$",
      "dest": "/api/internal-audits/[id]/evidence.js?id=$1"
    },
    {
      "src": "/api/internal-audits/([^/]+)$",
      "dest": "/api/internal-audits/[id].js?id=$1"
    },
    {
      "src": "/api/gspr/assessment/([^/]+)/new-version$",
      "dest": "/api/gspr/assessment/[id]/new-version.js?id=$1"
    },
    {
      "src": "/api/gspr/assessment/([^/]+)$",
      "dest": "/api/gspr/assessment/[id].js?id=$1"
    },
    {
      "src": "/api/gspr/items/([^/]+)/audit$",
      "dest": "/api/gspr/items/[id]/audit.js?id=$1"
    },
    {
      "src": "/api/gspr/items/([^/]+)/workflow$",
      "dest": "/api/gspr/items/[id]/workflow.js?id=$1"
    },
    {
      "src": "/api/gspr/items/([^/]+)$",
      "dest": "/api/gspr/items/[id].js?id=$1"
    },
    {
      "src": "/api/gspr/td/([^/]+)/submit$",
      "dest": "/api/gspr/td/[tdId]/submit.js?tdId=$1"
    },
    {
      "src": "/api/gspr/td/([^/]+)/approve$",
      "dest": "/api/gspr/td/[tdId]/approve.js?tdId=$1"
    },
    {
      "src": "/api/training/(.*)",
      "has": [
        {
          "type": "header",
          "key": "Access-Control-Request-Method"
        }
      ],
      "dest": "/api/training/options"
    },
    {
      "src": "/api/wiki/(.*)",
      "has": [
        {
          "type": "header",
          "key": "Access-Control-Request-Method"
        }
      ],
      "dest": "/api/_options"
    },
    {
      "src": "/api/training/sessions/([^/]+)/participants/([^/]+)/signature-token",
      "dest": "/api/training/signature-token?id=$1&participantId=$2"
    },
    {
      "src": "/api/training/sessions/([^/]+)/participants/([^/]+)/sign",
      "dest": "/api/training/sign?id=$1&participantId=$2"
    },
    {
      "src": "/api/training/sessions/([^/]+)",
      "dest": "/api/training/session?id=$1"
    },
    {
      "src": "/api/chat/v1/conversations/([^/]+)/messages$",
      "dest": "/api/chat/v1/conversations/[id]/messages.js?id=$1"
    },
    {
      "src": "/api/chat/v1/messages/([^/]+)$",
      "dest": "/api/chat/v1/messages/[id].js?id=$1"
    },
    {
      "src": "/api/chat/v1/conversations/([^/]+)$",
      "dest": "/api/chat/v1/conversations/[id]/index.js?id=$1"
    },
    {
      "src": "/api/admin/push/users/([^/]+)/devices$",
      "dest": "/api/admin/push/users/[userId]/devices.js?userId=$1"
    },
    {
      "src": "/api/admin/push/devices/([^/]+)$",
      "dest": "/api/admin/push/devices/[deviceId].js?deviceId=$1"
    },
    {
      "src": "/api/td/([^/]+)/export/nb-package$",
      "dest": "/api/td/[id]/export/nb-package.js?id=$1"
    },
    {
      "src": "/api/td/([^/]+)/changes$",
      "dest": "/api/td/[id]/changes.js?id=$1"
    },
    {
      "src": "/api/td/([^/]+)/links$",
      "dest": "/api/td/[id]/links.js?id=$1"
    },
    {
      "src": "/api/td/([^/]+)/sections$",
      "dest": "/api/td/[id]/sections.js?id=$1"
    },
    {
      "src": "/api/td/changes/([^/]+)/analyze$",
      "dest": "/api/td/changes/[changeId]/analyze.js?changeId=$1"
    },
    {
      "src": "/api/td/changes/([^/]+)$",
      "dest": "/api/td/changes/[changeId].js?changeId=$1"
    },
    {
      "src": "/api/td/links/([^/]+)$",
      "dest": "/api/td/links/[linkId].js?linkId=$1"
    },
    {
      "src": "/api/td/sections/([^/]+)$",
      "dest": "/api/td/sections/[sectionId].js?sectionId=$1"
    },
    {
      "src": "/api/td/readiness$",
      "dest": "/api/td/readiness.js"
    },
    {
      "src": "/api/td/([^/]+)/readiness$",
      "dest": "/api/td/[id]/readiness.js?id=$1"
    },
    {
      "src": "/api/td/sections/([^/]+)/content$",
      "dest": "/api/td/sections/[sectionId]/content.js?sectionId=$1"
    },
    {
      "src": "/api/td/impacts/([^/]+)$",
      "dest": "/api/td/impacts/[impactId].js?impactId=$1"
    },
    {
      "src": "/api/td/export/([^/]+)$",
      "dest": "/api/td/export/[exportId].js?exportId=$1"
    },
    {
      "src": "/api/td/([^/]+)$",
      "dest": "/api/td/[id].js?id=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/training-recurrence",
      "schedule": "0 * * * *"
    }
  ]
}
